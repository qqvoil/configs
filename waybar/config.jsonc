{
  "$schema": "https://gist.githubusercontent.com/Alexays/bb8c0a61b8d7a2d8505d8537b5d0c5a6/raw/waybar.schema.json",
  
  "layer": "top",
  "position": "top",
  "height": 30,
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,
  "spacing": 4,
  
  // Модули слева направо
  "modules-left": [
    "user",
    "hyprland/workspaces",
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "hyprland/language",
    "network",
    "tray"
  ],
  
"hyprland/language": {
    "format": "Lang: {}",
    "format-en": "En",
    "format-ru": "Ru",
    "keyboard-name": "telink-wireless-gaming-keyboard"
},
  "hyprland/workspaces": {
    "format": "{name}",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "6": "",
      "7": "",
      "8": "",
      "9": "",
      "urgent": "",
      "focused": "",
      "default": ""
    },
    "on-click": "activate",
    "sort-by": "id"
  },
  
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%A, %d %B %Y}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "interval": 60,
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "on-click-right": "mode"
    }
  },
  
  "network": {
    "format-ethernet": "󰈁",
    "format-disconnected": "󰈂",
    "format-alt": "{ifname}: {ipaddr}/{cidr}",
    "interval": 5
  },
  
  "user": {
    "format": "{user}",
    "on-click": "swaylock -f -c 000000",
    "tooltip": false
  },
  
  "tray": {
    "icon-size": 16,
    "spacing": 8
  }
}
